#!/usr/bin/env bash
# Repository-local wrapper for the chinalaw library admin server (chinalaw-server).
# 需要先 `scripts/install-local --with-server`（或在 venv 里 pip install '.[server]'）。
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VENV_PYTHON="${CHINALAW_VENV:-${REPO_ROOT}/.venv}/bin/python"

if [ -x "$VENV_PYTHON" ]; then
    exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 "$VENV_PYTHON" -m chinalaw.server.cli "$@"
fi

exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 \
    PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}" python3 -m chinalaw.server.cli "$@"
