#!/usr/bin/env bash
# 不安装包时的临时 wrapper：自动定位仓库 src/ 并以模块方式调用。
# 推荐做法：仍是在虚拟环境里 `pip install -e .` 注册全局 console_script，
# 见 README §「安装与使用」；本 wrapper 仅作为受限环境的回退。
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PYTHON_BIN="${CHINALAW_PYTHON:-${REPO_ROOT}/.venv/bin/python}"
if [ ! -x "$PYTHON_BIN" ]; then
    PYTHON_BIN="${PYTHON:-python3}"
fi

PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}" \
    exec "$PYTHON_BIN" -m chinalaw "$@"
