#!/usr/bin/env bash
# Install this checkout as the local agent-facing `chinalaw` command.
# 传 --with-server 时额外安装 `.[server]` 可选依赖并写 chinalaw-server shim。
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOOTSTRAP_PYTHON="${PYTHON:-python3}"
VENV_DIR="${CHINALAW_VENV:-${REPO_ROOT}/.venv}"
PYTHON_BIN="${VENV_DIR}/bin/python"
BIN_DIR="${CHINALAW_BIN_DIR:-${HOME}/.local/bin}"
TARGET="${BIN_DIR}/chinalaw"
MCP_TARGET="${BIN_DIR}/chinalaw-mcp"
SERVER_TARGET="${BIN_DIR}/chinalaw-server"
WITH_SERVER=0

usage() {
    cat <<'EOF'
Usage: scripts/install-local [options]

Create (or reuse) the repository .venv, editable-install this checkout, and
link chinalaw / chinalaw-mcp shims into ~/.local/bin (or CHINALAW_BIN_DIR).

Options:
  --with-server  Also install the `.[server]` extra (FastAPI/Uvicorn/MCP HTTP)
                 and link a chinalaw-server shim next to the other two.
  -h, --help     Show this help.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --with-server) WITH_SERVER=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

# pip install 的目标：默认只装核心（零运行依赖），--with-server 时装 server extra。
INSTALL_SPEC="$REPO_ROOT"
if [ "$WITH_SERVER" -eq 1 ]; then
    INSTALL_SPEC="${REPO_ROOT}[server]"
fi

# pyproject.toml 声明 requires-python >= 3.10；低于此版本时 venv 里的 pip 往往过旧、
# 不支持 PEP 660 editable install，报错还会伪装成「setup.py not found」这类误导信息。
# 因此在创建 venv 前显式校验解释器版本。
MIN_PY_MAJOR=3
MIN_PY_MINOR=10

py_version_ok() {
    # $1: python 可执行文件；满足 >= MIN_PY_MAJOR.MIN_PY_MINOR 时返回 0。
    "$1" -c "import sys; raise SystemExit(0 if sys.version_info[:2] >= (${MIN_PY_MAJOR}, ${MIN_PY_MINOR}) else 1)" \
        >/dev/null 2>&1
}

py_version_str() {
    "$1" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || printf 'unknown'
}

# 平台相关的 Python / venv 安装提示（原脚本只覆盖 Debian/Ubuntu，见 issue #4）。
python_setup_hint() {
    case "$(uname -s)" in
        Darwin)
            cat >&2 <<'EOF'
  macOS（Homebrew）：
    brew install python@3.12
  然后重跑 scripts/install-local，或显式指定解释器：
    PYTHON="$(brew --prefix python@3.12)/bin/python3.12" scripts/install-local
EOF
            ;;
        Linux)
            cat >&2 <<'EOF'
  Debian/Ubuntu：
    sudo apt-get install -y python3.12 python3.12-venv
  或用 pyenv / uv 安装 Python 3.10+，然后显式指定解释器：
    PYTHON=python3.12 scripts/install-local
EOF
            ;;
        *)
            cat >&2 <<'EOF'
  请安装 Python 3.10+（含 venv 模块），然后重跑，或用 PYTHON=/path/to/python 指定。
EOF
            ;;
    esac
}

# 确保用于创建 venv 的解释器满足 requires-python；仅在需要新建 venv 时调用。
resolve_bootstrap_python() {
    if py_version_ok "$BOOTSTRAP_PYTHON"; then
        return 0
    fi

    local found
    found="$(py_version_str "$BOOTSTRAP_PYTHON")"

    # 用户用 PYTHON=... 显式指定：尊重其选择，不擅自改用别的解释器，直接清晰报错。
    if [ -n "${PYTHON:-}" ]; then
        echo "error: PYTHON=${PYTHON} 指向 Python ${found}，但 chinalaw 需要 >= ${MIN_PY_MAJOR}.${MIN_PY_MINOR}。" >&2
        python_setup_hint
        exit 1
    fi

    # 默认 python3 太旧：自动探测系统里更新的解释器。
    local cand
    for cand in python3.13 python3.12 python3.11 python3.10; do
        if command -v "$cand" >/dev/null 2>&1 && py_version_ok "$cand"; then
            echo "note: 默认 python3 为 ${found}（< ${MIN_PY_MAJOR}.${MIN_PY_MINOR}），改用 $(command -v "$cand")。" >&2
            BOOTSTRAP_PYTHON="$cand"
            return 0
        fi
    done

    echo "error: 未找到 Python >= ${MIN_PY_MAJOR}.${MIN_PY_MINOR}（默认 python3 为 ${found}）。chinalaw 需要 ${MIN_PY_MAJOR}.${MIN_PY_MINOR}+。" >&2
    python_setup_hint
    exit 1
}

mkdir -p "$BIN_DIR"

if [ ! -x "$PYTHON_BIN" ]; then
    resolve_bootstrap_python
    if ! "$BOOTSTRAP_PYTHON" -m venv "$VENV_DIR"; then
        echo "warning: 创建 venv 失败（${BOOTSTRAP_PYTHON}）；改用 PYTHONPATH 回退模式安装 PATH wrapper。" >&2
        echo "如需启用完整的 editable 安装，请确保有可用的 Python 3.10+（含 venv 模块）：" >&2
        python_setup_hint
        echo "然后重跑 scripts/install-local。" >&2
    fi
fi

if [ -x "$PYTHON_BIN" ] && ! "$PYTHON_BIN" -m pip --version >/dev/null 2>&1; then
    if "$PYTHON_BIN" -m ensurepip --upgrade >/dev/null 2>&1; then
        echo "bootstrapped pip inside ${VENV_DIR}"
    else
        echo "warning: venv 已创建但 pip 不可用；改用 PYTHONPATH 回退模式。" >&2
        echo "请确保系统 Python 含 pip / venv 支持，然后重跑 scripts/install-local：" >&2
        python_setup_hint
    fi
fi

if [ -x "$PYTHON_BIN" ] && "$PYTHON_BIN" -m pip install -e "$INSTALL_SPEC"; then
    echo "editable install ok: ${INSTALL_SPEC} (${PYTHON_BIN})"
elif [ -x "$PYTHON_BIN" ]; then
    echo "editable install failed; wrapper will fall back to PYTHONPATH mode" >&2
    if [ "$WITH_SERVER" -eq 1 ]; then
        echo "  注意：--with-server 需要 editable 安装成功才能拿到 server 依赖；PYTHONPATH 回退模式下 chinalaw-server 无法运行。" >&2
    fi
    echo "  常见原因：venv 内 pip 过旧、不支持 PEP 660 editable 安装（报错可能伪装成" >&2
    echo "  「setup.py or setup.cfg not found」）。可升级 pip 后重跑：" >&2
    echo "    \"${PYTHON_BIN}\" -m pip install --upgrade pip && scripts/install-local" >&2
else
    echo "editable install skipped (无可用 venv)；wrapper will fall back to PYTHONPATH mode" >&2
fi

ln -sf "${REPO_ROOT}/scripts/chinalaw" "$TARGET"
ln -sf "${REPO_ROOT}/scripts/chinalaw-mcp" "$MCP_TARGET"
chmod +x "${REPO_ROOT}/scripts/chinalaw"
chmod +x "${REPO_ROOT}/scripts/chinalaw-mcp"

echo "installed wrapper: ${TARGET} -> ${REPO_ROOT}/scripts/chinalaw"
echo "installed wrapper: ${MCP_TARGET} -> ${REPO_ROOT}/scripts/chinalaw-mcp"
if [ "$WITH_SERVER" -eq 1 ]; then
    ln -sf "${REPO_ROOT}/scripts/chinalaw-server" "$SERVER_TARGET"
    chmod +x "${REPO_ROOT}/scripts/chinalaw-server"
    echo "installed wrapper: ${SERVER_TARGET} -> ${REPO_ROOT}/scripts/chinalaw-server"
fi
if ! command -v chinalaw >/dev/null 2>&1; then
    echo "warning: chinalaw is not on PATH. Add this to your shell profile:" >&2
    echo "  export PATH=\"${BIN_DIR}:\$PATH\"" >&2
elif [ "$(command -v chinalaw)" != "$TARGET" ]; then
    echo "warning: PATH resolves chinalaw to $(command -v chinalaw), not ${TARGET}" >&2
    echo "         put ${BIN_DIR} before other script dirs if Claude Code should use this checkout." >&2
fi

"$TARGET" --version
if [ "$WITH_SERVER" -eq 1 ]; then
    "$SERVER_TARGET" --version
fi
