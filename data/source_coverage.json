  "kind": "source_coverage_catalog",
  "description": "Machine-readable source coverage and maturity catalog for chinalaw-cli. This file records source capability boundaries; it is not legal authority.",
  "policy": {
    "principle": "Do not make every source support every command. Promote capabilities by source maturity, not by ad-hoc website additions.",
    "layers": [
      "fetch: one-document on-demand retrieval when detail pages are stable",
      "discover: candidate listing when search/list semantics are bounded",
      "sync: batch/incremental import only when pagination, ids, throttling, and version semantics are stable"
    ],
    "public_v2_gate": "A source may be promoted in the public release only after contract, tests, real smoke, provenance, fail-loud behavior, and anti-hardcode review pass."
  },
